---
interface Props {
  poster?: string;
  videoSrc?: string;
  description?: string;
}
const {poster,videoSrc,description='Área reservada à filmagem real do processo artesanal de cerâmica'}=Astro.props;
---
<div class="hero-visual" aria-label={description}>
  {videoSrc
    ? (
      <video class="hero-visual__video" poster={poster} controls playsinline preload="metadata" aria-label={description}>
        <source src={videoSrc} />
        Seu navegador não suporta o vídeo.
      </video>
    )
    : poster
      ? <img class="hero-visual__poster" src={poster} alt={description} fetchpriority="high" />
      : <div class="hero-visual__fallback" role="img" aria-label={description}>
          <span class="media-label">Imagem / vídeo artesanal pendente</span>
        </div>
  }
</div>

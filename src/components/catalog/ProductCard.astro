---
import '../../styles/product-card.css';
interface Props {
  name: string;
  href?: string;
  imageSrc?: string;
  imageAlt?: string;
  priceLabel?: string;
  categoryId?: string;
  kind?: string;
  preview?: boolean;
}
const {
  name,href,imageSrc,imageAlt,priceLabel='Preço a confirmar',
  categoryId,kind='peca',preview=false,
}=Astro.props;
---
<article class="product-card" data-category={categoryId} data-preview={preview ? 'true' : undefined}>
  {href
    ? (
      <a class="product-card__media" href={href} aria-label={name}>
        {imageSrc ? <img src={imageSrc} alt={imageAlt ?? name} loading="lazy" width="500" height="550" />
          : <span class:list={['product-card__placeholder',`product-card__placeholder--${kind}`]}>
              <span>Foto pendente</span>
            </span>}
      </a>
    )
    : <div class="product-card__media" aria-label={`Fotografia de ${name} pendente`}>
        {imageSrc ? <img src={imageSrc} alt={imageAlt ?? name} loading="lazy" width="500" height="550" />
          : <span class:list={['product-card__placeholder',`product-card__placeholder--${kind}`]}>
              <span>Foto pendente</span>
            </span>}
      </div>
  }
  <div class="product-card__copy">
    <p class="product-card__name">{name}</p>
    <p class="product-card__price">{priceLabel}</p>
  </div>
</article>
